# ======================================================================
# nalpia Intranet – Konfiguration (Kopie als .env anlegen und ausfüllen)
# ======================================================================

# Öffentliche Adresse des Intranets (mit https://). Muss zur Zoho-Redirect-URI passen.
APP_URL=https://intranet.nalpia.com
# Nur für docker-compose/Caddy: Domain ohne https://
INTRANET_DOMAIN=intranet.nalpia.com
NODE_ENV=production

# Geheimer Schlüssel (mind. 32 Zeichen) – verschlüsselt Zoho-Tokens und 2FA-Secrets.
# Erzeugen: openssl rand -base64 48   — NIE ändern, sonst müssen alle Postfächer neu verbunden werden.
APP_SECRET=

# Erste Admin-Person: Beim allerersten Start wird das Konto angelegt. Den Link zum Passwort-Festlegen
# gibt es per E-Mail (wenn SMTP eingerichtet ist) oder mit:
#   docker compose exec intranet node dist/server/cli.js reset-link --email denis@nalpia.com
BOOTSTRAP_ADMIN_EMAIL=denis@nalpia.com
BOOTSTRAP_ADMIN_NAME=Denis Keller

# Nur Adressen dieser Domains dürfen eingeladen werden (kommagetrennt, leer = alle)
ALLOWED_EMAIL_DOMAINS=nalpia.com

# Sitzungsdauer in Tagen (gleitend, max. 90 Tage absolut)
SESSION_DAYS=14

# ---------- Zoho Mail (pro Mitarbeiter eigenes Postfach per OAuth) ----------
# API Console: https://api-console.zoho.eu → "Server-based Applications"
# Redirect URI dort eintragen: <APP_URL>/api/mail/oauth/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
# Nur nötig, wenn die Mail-API nicht automatisch erkannt wird:
# ZOHO_MAIL_API_URL=https://mail.zoho.eu
# Verbinden nur erlaubt, wenn das Zoho-Postfach zur Intranet-E-Mail passt (empfohlen: true)
ZOHO_ENFORCE_EMAIL_MATCH=true

# ---------- Claude API ----------
# Schlüssel unter https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Mail-Entwürfe im Postfach (Antworten, Zusammenfassungen)
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_HOURLY_LIMIT=40
# Persönlicher KI-Assistent (Chatfenster)
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_HOURLY_LIMIT=60
# Übersetzung von Inhalten in die Oberflächensprache (News, Aufgaben, Notizen …), in der Datenbank gecacht
TRANSLATE_MODEL=claude-haiku-5-5
TRANSLATE_HOURLY_LIMIT=300

# ---------- Fundraising-Agent ----------
# Modell für Recherche, Erstmail-Entwürfe, Follow-ups und Antwort-Klassifizierung (stärkstes verfügbares Modell)
AGENT_MODEL=claude-opus-5-5
# Scheduler im Serverprozess (alle 5 Minuten: Posteingang, tägliche Entwürfe, Follow-ups, Autopilot-Versand)
AGENT_SCHEDULER=true
# Zeitzone für Tagesbatches ("Entwürfe um 7 Uhr") – das Sendefenster hat eine eigene Zeitzone in den Agent-Einstellungen
AGENT_TZ=Europe/Berlin
# Modus (Prüfmodus/Autopilot), Zielmarkt, Tageslimits, Vorlagen und Playbook werden in der Oberfläche
# unter Agent → Einstellungen gepflegt. Standard: Prüfmodus – nichts geht ohne Klick raus.

# ---------- System-E-Mails (optional, für Einladungen & "Passwort vergessen") ----------
# z. B. ein Zoho-Postfach intranet@nalpia.com mit App-Passwort
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="nalpia Intranet <intranet@nalpia.com>"

# Demo-Modus mit Beispieldaten (NIEMALS in Produktion)
DEMO_MODE=false
