{
  "name": "nalpia-intranet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "nalpia Intranet – Fundraising-CRM mit KI-Agent, Aufgaben, Meilensteine, Postfach und Kontakte",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "admin": "node dist/server/cli.js",
    "admin:dev": "tsx server/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/sofia-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^1.19.17",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-query": "^5.104.5",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.17",
    "hono": "^4.13.14",
    "ical.js": "^2.2.1",
    "imapflow": "^2.12.2",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "tsdav": "^2.5.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.31",
    "smtp-server": "^3.21.7",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
